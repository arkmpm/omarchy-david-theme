# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#ffffff"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#2dd4bf"

# Background color of selected item in processes box
theme[selected_bg]="#16302c"

# Foreground color of selected item in processes box
theme[selected_fg]="#2dd4bf"

# Color of inactive/disabled text
theme[inactive_fg]="#7a7a7a"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#ececec"

# Background color of the percentage meters
theme[meter_bg]="#16302c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ececec"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#7b31fc"
theme[mem_box]="#8fd19e"
theme[net_box]="#e06c75"
theme[proc_box]="#2dd4bf"

# Box divider line and small boxes line color
theme[div_line]="#7a7a7a"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8fd19e"
theme[temp_mid]="#e5d4a1"
theme[temp_end]="#e06c75"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#7b31fc"
theme[cpu_mid]="#2dd4bf"
theme[cpu_end]="#2dd4bf"

# Mem/Disk free meter
theme[free_start]="#7b31fc"
theme[free_mid]="#2dd4bf"
theme[free_end]="#2dd4bf"

# Mem/Disk cached meter
theme[cached_start]="#2dd4bf"
theme[cached_mid]="#2dd4bf"
theme[cached_end]="#7b31fc"

# Mem/Disk available meter
theme[available_start]="#e5d4a1"
theme[available_mid]="#e06c75"
theme[available_end]="#e06c75"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8fd19e"
theme[used_mid]="#2dd4bf"
theme[used_end]="#2dd4bf"

# Download graph colors
theme[download_start]="#e5d4a1"
theme[download_mid]="#e06c75"
theme[download_end]="#e06c75"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8fd19e"
theme[upload_mid]="#2dd4bf"
theme[upload_end]="#2dd4bf"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#2dd4bf"
theme[process_mid]="#2dd4bf"
theme[process_end]="#7b31fc"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#000000"
theme[gradient_color_1]="#141414"
theme[gradient_color_2]="#16302c"
theme[gradient_color_3]="#7a7a7a"
theme[gradient_color_4]="#505050"
theme[gradient_color_5]="#ffffff"
theme[gradient_color_6]="#ececec"
theme[gradient_color_7]="#ffffff"
